{
  "name": "mi-empresa-backend",
  "version": "1.0.0",
  "description": "Mi Empresa backend API",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:bash && npm run test:api",
    "test:bash": "./tests/auth/auth.test.sh",
    "test:api": "playwright test",
    "test:api:ui": "playwright test --ui",
    "test:api:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "instruments:upgrade": "tsx scripts/instruments-upgrade.ts",
    "db:studio": "prisma studio",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "build:lambda": "sam build",
    "local:lambda": "sam local start-api --env-vars env.local.json --warm-containers EAGER",
    "test:serverless": "TEST_API_URL=http://127.0.0.1:3000 playwright test tests/serverless/",
    "deploy:dev": "sam deploy",
    "deploy:prod": "sam deploy --config-env prod"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1005.0",
    "@aws-sdk/s3-request-presigner": "^3.1005.0",
    "@prisma/adapter-pg": "^6.19.2",
    "@prisma/client": "^6.19.2",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.13.3",
    "serverless-http": "^4.0.0",
    "winston": "^3.17.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/aws-lambda": "^8.10.161",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^6.0.2",
    "esbuild": "^0.27.3",
    "eslint": "^9.20.0",
    "prettier": "^3.5.2",
    "prisma": "^6.19.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
