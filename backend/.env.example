NODE_ENV=development
PORT=3001

# Database
DATABASE_URL=postgresql://miempresa:miempresa123@localhost:15432/miempresa_dev

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=24h

# AWS S3 — the ONLY file storage (no local/VM filesystem storage exists).
# Backend signs presigned URLs; the browser PUTs directly to this bucket.
# Buckets are created by infrastructure/db/cloudformation/s3-stack.yml:
#   local dev  -> miempresa-uploads-<accountId>-dev      (stack miempresa-s3-dev)
#   staging VM -> miempresa-uploads-<accountId>-staging  (from SSM, set by env.sh)
# No default in code: if this var is missing, upload endpoints fail with a clear error.
AWS_REGION=us-east-1
AWS_S3_BUCKET=miempresa-uploads-<accountId>-dev
AWS_PROFILE=

# ---------------------------------------------------------------------------
# CORS INVARIANT — keep in sync with the S3 bucket allowlist
# ---------------------------------------------------------------------------
# Every browser origin that reaches this backend (frontend serving origin,
# NUXT_PUBLIC_API_BASE, any reverse-proxy / Tailscale host) MUST also be
# listed in the matching bucket's UploadsCorsAllowedOrigins in s3-stack.yml,
# otherwise the browser's OPTIONS preflight against the presigned PUT URL
# returns CORS 403 and uploads silently fail.
#
# Authoritative allowlist (single source of truth):
#   * dev      -> DEV_LOCAL_ORIGINS in scripts/deploy-infrastructure.sh
#                 (redeploys miempresa-s3-dev with the override)
#   * staging  -> s3-stack.yml default + any per-deploy override
#   * prod     -> s3-stack.yml default (only the prod hostname)
#
# If you add a new dev origin (LAN IP, tunnel, reverse proxy), you MUST:
#   1. Add it to DEV_LOCAL_ORIGINS in deploy-infrastructure.sh
#   2. Re-run `bash deploy-infrastructure.sh --stage dev` (or call
#      `aws cloudformation deploy` directly against `miempresa-s3-dev`
#      with `UploadsCorsAllowedOrigins=<override>` --profile disruptive
#      --region us-east-1)
#   3. Verify with: aws s3api get-bucket-cors --bucket <bucket>
#      --region us-east-1 --profile disruptive
# ---------------------------------------------------------------------------

# CORS
CORS_ORIGIN=http://localhost:3101

# File Upload
MAX_FILE_SIZE_MB=100
