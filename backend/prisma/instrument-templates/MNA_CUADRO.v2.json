{
  "codigo": "MNA_CUADRO",
  "nombre": "Mini Nutritional Assessment (MNA) + Cuadro de Alimentos",
  "version": 2,
  "tipo": "NUTRICION",
  "mergeOf": [
    "MNA",
    "CUADRO_ALIMENTOS"
  ],
  "descripcion": "Evalúa el estado nutricional del abuelo/a mediante cribaje + evaluación (MNA completo de Nestlé Nutrition Institute) y registra texto libre de frecuencia por grupo de alimentos.",
  "instructions": "Complete el cribaje (preguntas A–F). Si el subtotal de cribaje es ≥ 12, la evaluación es opcional (estado nutricional normal probable). De lo contrario, complete la evaluación (G–R) para obtener la clasificación final. El Cuadro de Alimentos siempre se completa.",
  "sections": [
    {
      "id": "cribaje",
      "titulo": "Cribaje (screening)",
      "instructions": "Responda a la primera parte del cuestionario indicando la puntuación adecuada para cada pregunta. Sume los puntos correspondientes al cribaje (máx 14).",
      "subtotal": {
        "max": 14,
        "resultEvaluation": [
          {
            "min": 12,
            "max": 14,
            "label": "Estado nutricional normal"
          },
          {
            "min": 8,
            "max": 11,
            "label": "Riesgo de malnutrición"
          },
          {
            "min": 0,
            "max": 7,
            "label": "Malnutrición"
          }
        ]
      },
      "items": [
        {
          "id": "a_apetito",
          "label": "A. ¿Ha perdido el apetito? ¿Ha comido menos por falta de apetito, problemas digestivos, dificultades de masticación o deglución en los últimos 3 meses?",
          "type": "single-select-scored",
          "required": true,
          "options": [
            {
              "value": "mucho_menos",
              "label": "Ha comido mucho menos",
              "score": 0
            },
            {
              "value": "menos",
              "label": "Ha comido menos",
              "score": 1
            },
            {
              "value": "igual",
              "label": "Ha comido igual",
              "score": 2
            }
          ]
        },
        {
          "id": "b_peso",
          "label": "B. Pérdida reciente de peso (<3 meses)",
          "type": "single-select-scored",
          "required": true,
          "options": [
            {
              "value": "mas_3kg",
              "label": "Pérdida de peso > 3 kg",
              "score": 0
            },
            {
              "value": "no_sabe",
              "label": "No lo sabe",
              "score": 1
            },
            {
              "value": "entre_1_3",
              "label": "Pérdida de peso entre 1 y 3 kg",
              "score": 2
            },
            {
              "value": "sin_perdida",
              "label": "No ha habido pérdida de peso",
              "score": 3
            }
          ]
        },
        {
          "id": "c_movilidad",
          "label": "C. Movilidad",
          "type": "single-select-scored",
          "required": true,
          "options": [
            {
              "value": "cama_sillon",
              "label": "De la cama al sillón",
              "score": 0
            },
            {
              "value": "interior",
              "label": "Autonomía en el interior",
              "score": 1
            },
            {
              "value": "sale",
              "label": "Sale del domicilio",
              "score": 2
            }
          ]
        },
        {
          "id": "d_enfermedad",
          "label": "D. ¿Ha tenido una enfermedad aguda o situación de estrés psicológico en los últimos 3 meses?",
          "type": "single-select-scored",
          "required": true,
          "options": [
            {
              "value": "si",
              "label": "Sí",
              "score": 0
            },
            {
              "value": "no",
              "label": "No",
              "score": 2
            }
          ]
        },
        {
          "id": "e_neuropsico",
          "label": "E. Problemas neuropsicológicos",
          "type": "single-select-scored",
          "required": true,
          "options": [
            {
              "value": "demencia_grave",
              "label": "Demencia o depresión grave",
              "score": 0
            },
            {
              "value": "demencia_leve",
              "label": "Demencia leve",
              "score": 1
            },
            {
              "value": "sin_problemas",
              "label": "Sin problemas psicológicos",
              "score": 2
            }
          ]
        },
        {
          "id": "f1_peso",
          "label": "F1. Peso en kg (para cálculo de IMC)",
          "type": "number-info",
          "required": true,
          "constraints": {
            "min": 20,
            "max": 300
          }
        },
        {
          "id": "f2_talla",
          "label": "F2. Talla en cm (para cálculo de IMC)",
          "type": "number-info",
          "required": true,
          "constraints": {
            "min": 80,
            "max": 230
          }
        },
        {
          "id": "f_imc",
          "label": "F. Índice de masa corporal (IMC) = peso en kg / (talla en m)²",
          "type": "single-select-scored",
          "required": true,
          "options": [
            {
              "value": "imc_lt_19",
              "label": "IMC < 19",
              "score": 0
            },
            {
              "value": "imc_19_21",
              "label": "19 ≤ IMC < 21",
              "score": 1
            },
            {
              "value": "imc_21_23",
              "label": "21 ≤ IMC < 23",
              "score": 2
            },
            {
              "value": "imc_ge_23",
              "label": "IMC ≥ 23",
              "score": 3
            }
          ]
        }
      ]
    },
    {
      "id": "evaluacion",
      "titulo": "Evaluación",
      "instructions": "Complete la evaluación si el subtotal de cribaje fue < 12. Si el cribaje fue ≥ 12 esta sección es opcional: puede omitirse (la clasificación se toma del cribaje) o completarse para una evaluación más detallada (la clasificación global 0–30 aplica).",
      "subtotal": {
        "max": 16
      },
      "condition": {
        "skipIf": {
          "sectionId": "cribaje",
          "op": ">=",
          "value": 12
        }
      },
      "items": [
        {
          "id": "g_vive_independiente",
