// Mi Empresa App - Database Schema
// Version: 2.0 based on schema-v2.md
// Generator and Datasource

generator client {
  provider   = "prisma-client-js"
  output     = "../src/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========================================
// AUTHENTICATION MODULE
// ========================================

model Usuario {
  id        Int      @id @default(autoincrement())
  email     String   @unique @db.VarChar(255)
  password  String   @db.VarChar(255)
  rol       RolUsuario
  nombre    String   @db.VarChar(100)
  apellido  String   @db.VarChar(100)
  activo    Boolean  @default(true)
  empleadoId Int?    @map("empleado_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  // jul-10 C6/L2: sub-role specialization (nullable — only set for EMPLEADO accounts with a known specialization)
  tipoEmpleado TipoEmpleado? @map("tipo_empleado")

  // Relations
  empleado                  Empleado?  @relation(fields: [empleadoId], references: [id], onDelete: SetNull)
  sesiones                  Sesion[]
  instrumentosCreados       Instrumento[]  @relation("InstrumentoCreador")
  instrumentosModificados   Instrumento[]  @relation("InstrumentoModificador")
  instrumentosVersionesCreadas InstrumentoVersion[] @relation("InstrumentoVersionCreador")
  registrosResponsables     RegistroFichaCompletada[] @relation("RegistroResponsable")
  notasCliente              NotaCliente[]
  certificadosEmpresaCreados CertificadoEmpresa[] @relation("CertificadoEmpresaCreador")
  certificadosEmpresaUpdates CertificadoUpdate[] @relation("CertificadoUpdateCreador")
  
  pendientesCreados         PendienteEmpleado[]    @relation("PendienteCreador")

  novedadesCreadas          NovedadEmpleado[]      @relation("NovedadCreador")
  // nomina-asistencia-jul-18
  asistenciasRegistradas    AsistenciaEmpleado[]   @relation("AsistenciaRegistrador")

  @@map("usuarios")
}

model Sesion {
  id           Int      @id @default(autoincrement())
  usuarioId    Int      @map("usuario_id")
  token        String   @unique @db.VarChar(500)
  ip           String?  @db.VarChar(45)
  userAgent    String?  @map("user_agent") @db.VarChar(500)
  expiraEn     DateTime @map("expira_en")
  activa       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([token])
  @@index([expiraEn])
  @@map("sesiones")
}

// ========================================
// EMPLOYEE MANAGEMENT MODULE
// ========================================

model Empleado {
  id                   Int       @id @default(autoincrement()) @map("empleado_id")
  nombre               String    @db.VarChar(100)
  apellido             String    @db.VarChar(100)
  tipoDocumento        TipoDocumentoEmpleado @map("tipo_documento")
  numeroDocumento      String    @unique @map("numero_documento") @db.VarChar(50)
  permisoTrabajo       Boolean   @map("permiso_trabajo") @default(false)
  genero               String    @db.VarChar(20)
  fechaNacimiento      DateTime  @map("fecha_nacimiento") @db.Date
  tipoVivienda         TipoVivienda? @map("tipo_vivienda")
  direccion            String?   @db.VarChar(255)
  estratoSocioeconomico Int?     @map("estrato_socioeconomico")
  estadoCivil          String?   @map("estado_civil") @db.VarChar(50)
  telefono             String?   @db.VarChar(20)
  email                String?   @db.VarChar(255)
  estado               EstadoEmpleado @default(ACTIVO)
  fechaRegistro        DateTime  @default(now()) @map("fecha_registro")
  hojaVidaUrl          String?   @map("hoja_vida_url") @db.VarChar(500)
  // jul-9 D3: identity-document file URL
  documentoIdentificacionUrl String? @map("documento_identificacion_url") @db.VarChar(500)

  // nomina-asistencia-jul-18: medio de pago de nómina (optional)
  medioPagoTipo       MedioPagoNomina? @map("medio_pago_tipo")
  medioPagoNequi      String?          @map("medio_pago_nequi") @db.VarChar(50)
  bancoNombre         String?          @map("banco_nombre") @db.VarChar(100)
  bancoTipoCuenta     TipoCuentaBanco? @map("banco_tipo_cuenta")
  bancoNumeroCuenta   String?          @map("banco_numero_cuenta") @db.VarChar(50)

  // qa-session-jul-31 R3: optional EPS / Fondo de pensiones / ARL (free-text, no catalog).
  eps                  String? @map("eps")                  @db.VarChar(100)
  fondoPensiones       String? @map("fondo_pensiones")      @db.VarChar(100)
  arl                  String? @map("arl")                  @db.VarChar(100)

  // qa-session-jul-31 followup (aug-04): admin "bloqueador" lock. When bloqueado
  // is true, non-ADMIN roles cannot edit this empleado / its contratos / medio de
  // pago. Only ADMIN can set or clear it (via the dedicated lock/unlock endpoints);
  // these columns are NEVER accepted on the normal create/update payload.
  // bloqueadoPor is an audit-only scalar (admin usuario id) — no FK relation, to
  // avoid a second Empleado↔Usuario relation.
  bloqueado            Boolean   @default(false) @map("bloqueado")
  bloqueadoPor         Int?      @map("bloqueado_por")
  bloqueadoEn          DateTime? @map("bloqueado_en")

  // Relations
  usuarios                     Usuario[]
  nucleoFamiliar               NucleoFamiliar[]
  contactosEmergencia          ContactoEmergenciaEmpleado[]
  cargos                       Cargo[]
  experienciasLaborales        ExperienciaLaboralExterna[]
  educacionIdiomas             EducacionIdiomas[]
  vehiculos                    Vehiculo[]
  certificados                 CertificadoEmpleado[]
  datosMigracion               DatosMigracion?
  nominas                      Nomina[]
  vacaciones                   GestionTiempoVacaciones[]
  ausentismos                  Ausentismo[]
  // jul4
  pendientes                   PendienteEmpleado[]
  novedades                    NovedadEmpleado[]
  contratos                    Contrato[]
  nominaPeriodos               NominaPeriodo[]
  // jul-9 D2: repeatable education entries
  educacionEmpleado            EducacionEmpleado[]
  // nomina-asistencia-jul-18
  asistencias                  AsistenciaEmpleado[]

  @@index([numeroDocumento])
  @@index([estado])
  @@map("empleados")
}

model NucleoFamiliar {
  id              Int      @id @default(autoincrement()) @map("nucleo_id")
  empleadoId      Int      @map("empleado_id")
  nombre          String   @db.VarChar(100)
  apellido        String   @db.VarChar(100)
  tipoDocumento   TipoDocumentoFamiliar @map("tipo_documento")
  numeroDocumento String?  @map("numero_documento") @db.VarChar(50)
  fechaNacimiento DateTime @map("fecha_nacimiento") @db.Date
  genero          String   @db.VarChar(20)
  telefono        String?  @db.VarChar(20)
  parentesco      String   @db.VarChar(50)

  // Relations
  empleado Empleado @relation(fields: [empleadoId], references: [id], onDelete: Cascade)

  @@index([empleadoId])
  @@map("nucleos_familiares")
}

model ContactoEmergenciaEmpleado {
  id         Int    @id @default(autoincrement()) @map("contacto_id")
  empleadoId Int    @map("empleado_id")
  nombre     String @db.VarChar(100)
  apellido   String @db.VarChar(100)
  telefono   String @db.VarChar(20)
  parentesco String @db.VarChar(50)

  // Relations
  empleado Empleado @relation(fields: [empleadoId], references: [id], onDelete: Cascade)

  @@index([empleadoId])
  @@map("contactos_emergencia_empleados")
}

model Cargo {
  id                Int       @id @default(autoincrement()) @map("cargo_id")
  empleadoId        Int       @map("empleado_id")
  fechaIngreso      DateTime  @map("fecha_ingreso") @db.Date
  fechaTerminacion  DateTime? @map("fecha_terminacion") @db.Date
  nombreCargo       String    @map("nombre_cargo") @db.VarChar(100)
  ubicacion         String    @db.VarChar(255)
  salario           Decimal?  @map("salario") @db.Decimal(12, 2)

  // Relations
  empleado Empleado @relation(fields: [empleadoId], references: [id], onDelete: Cascade)

  @@index([empleadoId])
  @@map("cargos")
}

model ExperienciaLaboralExterna {
  id               Int       @id @default(autoincrement()) @map("experiencia_id")
  empleadoId       Int       @map("empleado_id")
  empresa          String    @db.VarChar(200)
  telefonoEmpresa  String?   @map("telefono_empresa") @db.VarChar(20)
  cargo            String    @db.VarChar(100)
  sector           String?   @db.VarChar(100)
  periodoInicio    DateTime  @map("periodo_inicio") @db.Date
  periodoFin       DateTime? @map("periodo_fin") @db.Date
  funcionesLogros  String?   @map("funciones_logros") @db.Text

  // Relations
  empleado Empleado @relation(fields: [empleadoId], references: [id], onDelete: Cascade)

  @@index([empleadoId])
  @@map("experiencias_laborales_externas")
}

model EducacionEmpleado {
  id              Int       @id @default(autoincrement()) @map("educacion_empleado_id")
  empleadoId      Int       @map("empleado_id")
  profesion       String    @db.VarChar(200)
  universidad     String?   @db.VarChar(200)
  fechaGraduacion DateTime? @map("fecha_graduacion") @db.Date
  diplomaUrl      String?   @map("diploma_url") @db.VarChar(500)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  empleado Empleado @relation(fields: [empleadoId], references: [id], onDelete: Cascade)

  @@index([empleadoId])
  @@map("educacion_empleado")
}

model EducacionIdiomas {
  id                 Int     @id @default(autoincrement()) @map("idioma_id")
  empleadoId         Int     @map("empleado_id")
  institucion        String  @db.VarChar(200)
  // jul-9 D1: nivelEscritura nullable (was required) — column preserved, hide in UI, stop writing
  nivelEscritura     String? @map("nivel_escritura") @db.VarChar(50)
  nivelHabla         String  @map("nivel_habla") @db.VarChar(50)
  capacidadTraducir  Boolean @map("capacidad_traducir") @default(false)

  // Relations
  empleado Empleado @relation(fields: [empleadoId], references: [id], onDelete: Cascade)

  @@index([empleadoId])
  @@map("educacion_idiomas")
}

model Vehiculo {
  id             Int    @id @default(autoincrement()) @map("vehiculo_id")
  empleadoId     Int    @map("empleado_id")
  tipoVehiculo   String @map("tipo_vehiculo") @db.VarChar(50)
  placas         String @db.VarChar(20)
  tipoLicencia   String @map("tipo_licencia") @db.VarChar(20)
  numeroLicencia String @map("numero_licencia") @db.VarChar(50)

  // Relations
  empleado Empleado @relation(fields: [empleadoId], references: [id], onDelete: Cascade)

  @@index([empleadoId])
  @@map("vehiculos")
}

model CertificadoEmpleado {
  id                Int                     @id @default(autoincrement()) @map("cert_empleado_id")
  empleadoId        Int                     @map("empleado_id")
  tipo              TipoCertificadoEmpleado
  nombre            String?                 @db.VarChar(200)
  fechaExpedicion   DateTime                @map("fecha_expedicion") @db.Date
  fechaVencimiento  DateTime                @map("fecha_vencimiento") @db.Date
  archivoUrl        String?                 @map("archivo_url") @db.VarChar(500)
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")

  // Relations
  empleado Empleado @relation(fields: [empleadoId], references: [id], onDelete: Cascade)

  @@index([empleadoId])
  @@index([tipo])
  @@map("certificados_empleado")
}

model DatosMigracion {
  id                    Int       @id @default(autoincrement()) @map("migracion_id")
  empleadoId            Int       @unique @map("empleado_id")
  numeroPasaporte       String    @map("numero_pasaporte") @db.VarChar(50)
  pasaporteExpedicion   DateTime  @map("pasaporte_expedicion") @db.Date
  pasaporteVencimiento  DateTime  @map("pasaporte_vencimiento") @db.Date
  numeroVisa            String?   @map("numero_visa") @db.VarChar(50)
  visaExpedicion        DateTime? @map("visa_expedicion") @db.Date
  visaVencimiento       DateTime? @map("visa_vencimiento") @db.Date

  // Relations
  empleado Empleado @relation(fields: [empleadoId], references: [id], onDelete: Cascade)

  @@map("datos_migracion")
}

// ========================================
// PAYROLL MODULE
// ========================================

model Nomina {
  id                 Int           @id @default(autoincrement()) @map("nomina_id")
  empleadoId         Int           @map("empleado_id")
  tipoContrato       TipoContrato  @map("tipo_contrato")
  fechaInicio        DateTime      @map("fecha_inicio") @db.Date
  fechaTerminacion   DateTime?     @map("fecha_terminacion") @db.Date
  cargo              String        @db.VarChar(100)
  salario            Decimal       @db.Decimal(15, 2)
  fechaPago          DateTime      @map("fecha_pago") @db.Date
  periodo            PeriodoPago   @default(MENSUAL)

  // Relations
  empleado           Empleado              @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  deducciones        DeduccionSalario[]
  beneficios         Beneficio[]
  comprobantesPago   ComprobantePago[]

  @@index([empleadoId])
  @@index([fechaPago])
  @@map("nominas")
}


model PendienteEmpleado {
  id            Int             @id @default(autoincrement()) @map("pendiente_id")
  empleadoId    Int             @map("empleado_id")
  descripcion   String          @db.VarChar(500)
  estado        EstadoPendiente @default(PENDIENTE)
  creadoPor     Int             @map("creado_por")
  createdAt     DateTime        @default(now()) @map("created_at")
  fechaResuelto DateTime?       @map("fecha_resuelto")

  empleado Empleado @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  creador  Usuario  @relation("PendienteCreador", fields: [creadoPor], references: [id])

  @@index([empleadoId])
  @@index([estado])
  @@map("pendientes_empleado")
}


model NovedadEmpleado {
  id          Int          @id @default(autoincrement()) @map("novedad_id")
  empleadoId  Int          @map("empleado_id")
  tipo        TipoNovedad
  titulo      String       @db.VarChar(200)
  descripcion String?      @db.Text
  fechaInicio DateTime     @map("fecha_inicio") @db.Date
  fechaFin    DateTime?    @map("fecha_fin") @db.Date
  creadoPor   Int          @map("creado_por")
  createdAt   DateTime     @default(now()) @map("created_at")

  empleado Empleado         @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  creador  Usuario          @relation("NovedadCreador", fields: [creadoPor], references: [id])
  archivos ArchivoNovedad[]

  @@index([empleadoId])
  @@index([tipo])
  @@map("novedades_empleado")
}

model ArchivoNovedad {
  id        Int    @id @default(autoincrement()) @map("archivo_novedad_id")
  novedadId Int    @map("novedad_id")
  nombre    String @db.VarChar(200)
  url       String @db.VarChar(500)

  novedad NovedadEmpleado @relation(fields: [novedadId], references: [id], onDelete: Cascade)

  @@index([novedadId])
  @@map("archivos_novedad")
}


model Contrato {
  id           Int          @id @default(autoincrement()) @map("contrato_id")
  empleadoId   Int          @map("empleado_id")
  tipoContrato TipoContrato @map("tipo_contrato")
  fechaInicio  DateTime     @map("fecha_inicio") @db.Date
  fechaFin     DateTime?    @map("fecha_fin") @db.Date
  archivoUrl   String?      @map("archivo_url") @db.VarChar(500)
  // jul-9 D6: signed-contract file URL
  archivoFirmadoUrl String? @map("archivo_firmado_url") @db.VarChar(500)
  // jul-9 D7 (nullable in jul-9; jul-10 tighten: SET NOT NULL after backfill to "Otro")
  cargoId       Int        @map("cargo_id")
  cargo         CargoEmpresa @relation(fields: [cargoId], references: [id], onDelete: Restrict)
  // nomina-asistencia-jul-18: rate per media jornada (4h); required on CREATE at API layer
  valorJornada  Decimal?   @map("valor_jornada") @db.Decimal(12, 2)
  // qa-session-jul-24 R7: monthly salary; required for non-OPS contract types at API layer
  valorMensual  Decimal?   @map("valor_mensual") @db.Decimal(12, 2)
  activo       Boolean      @default(true)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  empleado Empleado        @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  periodos NominaPeriodo[]

  @@index([empleadoId])
  @@index([cargoId])
  @@map("contratos")
}

model CargoEmpresa {
  id        Int       @id @default(autoincrement()) @map("cargo_id")
  empresaId Int       @map("empresa_id")
  nombre    String    @db.VarChar(100)
  activo    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  // Relations
  empresa   Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  contratos Contrato[]

  @@unique([empresaId, nombre])
  @@index([empresaId])
  @@map("cargos_empresa")
}

model NominaPeriodo {
  id           Int          @id @default(autoincrement()) @map("nomina_periodo_id")
  empleadoId   Int          @map("empleado_id")
  contratoId   Int?         @map("contrato_id")
  periodo      DateTime     @db.Date
  tipoContrato TipoContrato @map("tipo_contrato")
  salario      Decimal?     @db.Decimal(12, 2)
  notas        String?      @db.Text
  // nomina-asistencia-jul-18: liquidación calc snapshot
  mediasJornadas    Decimal? @map("medias_jornadas") @db.Decimal(8, 2)
  valorJornada      Decimal? @map("valor_jornada") @db.Decimal(12, 2)
  subtotalCalculado Decimal? @map("subtotal_calculado") @db.Decimal(12, 2)
  aportesSociales   Decimal? @map("aportes_sociales") @db.Decimal(12, 2)
  totalPagado       Decimal? @map("total_pagado") @db.Decimal(12, 2)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  empleado Empleado               @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  contrato Contrato?              @relation(fields: [contratoId], references: [id], onDelete: SetNull)
  archivos ArchivoNominaPeriodo[]

  @@unique([empleadoId, periodo])
  @@index([periodo])
  @@map("nomina_periodos")
}

// nomina-asistencia-jul-18: daily AM/PM attendance (no rate fields)
model AsistenciaEmpleado {
  id            Int      @id @default(autoincrement()) @map("asistencia_id")
  empleadoId    Int      @map("empleado_id")
  fecha         DateTime @db.Date
  jornadaAm     Boolean  @default(false) @map("jornada_am")
  jornadaPm     Boolean  @default(false) @map("jornada_pm")
  notas         String?  @db.VarChar(500)
  registradoPor Int      @map("registrado_por")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  empleado    Empleado @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  registrador Usuario  @relation("AsistenciaRegistrador", fields: [registradoPor], references: [id])

  @@unique([empleadoId, fecha])
  @@index([fecha])
  @@index([empleadoId])
  @@map("asistencia_empleados")
}

model ArchivoNominaPeriodo {
  id              Int               @id @default(autoincrement()) @map("archivo_nomina_id")
  nominaPeriodoId Int               @map("nomina_periodo_id")
  tipoArchivo     TipoArchivoNomina @map("tipo_archivo")
  nombre          String            @db.VarChar(200)
  url             String            @db.VarChar(500)

  nominaPeriodo NominaPeriodo @relation(fields: [nominaPeriodoId], references: [id], onDelete: Cascade)

  @@index([nominaPeriodoId])
  @@map("archivos_nomina_periodo")
}

model DeduccionSalario {
  id          Int             @id @default(autoincrement()) @map("deduccion_id")
  nominaId    Int             @map("nomina_id")
  tipo        TipoDeduccion
  valor       Decimal         @db.Decimal(15, 2)
  descripcion String?         @db.Text

  // Relations
  nomina Nomina @relation(fields: [nominaId], references: [id], onDelete: Cascade)

  @@index([nominaId])
  @@map("deducciones_salario")
}

model Beneficio {
  id               Int     @id @default(autoincrement()) @map("beneficio_id")
  nominaId         Int     @map("nomina_id")
  nombreBeneficio  String  @map("nombre_beneficio") @db.VarChar(100)
  valor            Decimal @db.Decimal(15, 2)
  descripcion      String? @db.Text

  // Relations
  nomina Nomina @relation(fields: [nominaId], references: [id], onDelete: Cascade)

  @@index([nominaId])
  @@map("beneficios")
}

model ComprobantePago {
  id                 Int      @id @default(autoincrement()) @map("comprobante_id")
  nominaId           Int      @map("nomina_id")
  fechaGeneracion    DateTime @default(now()) @map("fecha_generacion")
  periodoInicio      DateTime @map("periodo_inicio") @db.Date
  periodoFin         DateTime @map("periodo_fin") @db.Date
  totalDevengado     Decimal  @map("total_devengado") @db.Decimal(15, 2)
  totalDeducciones   Decimal  @map("total_deducciones") @db.Decimal(15, 2)
  netoPagar          Decimal  @map("neto_pagar") @db.Decimal(15, 2)
  archivoPdf         String?  @map("archivo_pdf") @db.VarChar(500)

  // Relations
  nomina Nomina @relation(fields: [nominaId], references: [id], onDelete: Cascade)

  @@index([nominaId])
  @@map("comprobantes_pago")
}

// ========================================
// TIME MANAGEMENT MODULE
// ========================================

model GestionTiempoVacaciones {
  id                  Int                @id @default(autoincrement()) @map("vacacion_id")
  empleadoId          Int                @map("empleado_id")
  fechaInicio         DateTime           @map("fecha_inicio") @db.Date
  fechaFinalizacion   DateTime           @map("fecha_finalizacion") @db.Date
  diasTomados         Int                @map("dias_tomados")
  estado              EstadoSolicitud    @default(PENDIENTE)
  fechaSolicitud      DateTime           @default(now()) @map("fecha_solicitud")

  // Relations
  empleado Empleado @relation(fields: [empleadoId], references: [id], onDelete: Cascade)

  @@index([empleadoId])
  @@index([estado])
  @@map("gestion_tiempo_vacaciones")
}

model Ausentismo {
  id                  Int              @id @default(autoincrement()) @map("ausentismo_id")
  empleadoId          Int              @map("empleado_id")
  causa               CausaAusentismo
  tipoLicencia        TipoLicencia?    @map("tipo_licencia")
  fechaInicio         DateTime         @map("fecha_inicio") @db.Date
  fechaFin            DateTime         @map("fecha_fin") @db.Date
  certificadoAdjunto  String?          @map("certificado_adjunto") @db.VarChar(500)
  observaciones       String?          @db.Text

  // Relations
  empleado Empleado @relation(fields: [empleadoId], references: [id], onDelete: Cascade)

  @@index([empleadoId])
  @@map("ausentismos")
}

// ========================================
// CLIENT MANAGEMENT MODULE
// ========================================

model Cliente {
  id                      Int       @id @default(autoincrement()) @map("cliente_id")
  nombre                  String    @db.VarChar(100)
  tipoDocumento           TipoDocumentoCliente @map("tipo_documento")
  numeroDocumento         String    @unique @map("numero_documento") @db.VarChar(50)
  fechaNacimiento         DateTime  @map("fecha_nacimiento") @db.Date
  genero                  String    @db.VarChar(20)
  telefono                String?   @db.VarChar(20)
  email                   String?   @db.VarChar(255)
  fechaIngreso            DateTime  @default(now()) @map("fecha_ingreso")
  estado                  EstadoCliente @default(ACTIVO)
  notas                   String?   @db.Text
  informacionSeguro       String?   @map("informacion_seguro") @db.Text
  observacionesEspeciales String?   @map("observaciones_especiales") @db.Text
  // jul-9 B3/B4/B5: personal-health metadata
  fechaCumpleanos         DateTime? @map("fecha_cumpleanos") @db.Date
  tipoSangre              TipoSangre? @map("tipo_sangre")
  eps                     String?   @db.VarChar(200)

  // Relations
  contactosEmergencia     ContactoEmergenciaCliente[]
  registrosFichas         RegistroFichaCompletada[]
  notasCliente            NotaCliente[]
  prefacturas             Prefactura[]

  @@index([numeroDocumento])
  @@index([estado])
  @@map("clientes")
}

model ContactoEmergenciaCliente {
  id         Int    @id @default(autoincrement()) @map("contacto_id")
  clienteId  Int    @map("cliente_id")
  nombre     String @db.VarChar(100)
  telefono   String @db.VarChar(20)
  parentesco String @db.VarChar(50)

  // Relations
  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId])
  @@map("contactos_emergencia_clientes")
}

// ========================================
// FICHAS Y DOCUMENTOS SUB-MODULE
// ========================================

model Instrumento {
  id                  Int                   @id @default(autoincrement()) @map("instrumento_id")
  nombreInstrumento   String                @map("nombre_instrumento") @db.VarChar(200)
  codigo              String?               @unique @db.VarChar(50)
  descripcion         String?               @db.Text
  tipo                TipoInstrumento
  periodicidad        PeriodicidadInstrumento
  rolesPermitidos     String                @map("roles_permitidos") @db.VarChar(255)
  estado              EstadoInstrumento     @default(ACTIVO)
  fechaCreacion       DateTime              @default(now()) @map("fecha_creacion")
  creadoPor           Int                   @map("creado_por")
  fechaModificacion   DateTime?             @updatedAt @map("fecha_modificacion")
  modificadoPor       Int?                  @map("modificado_por")

  // Relations
  creador             Usuario               @relation("InstrumentoCreador", fields: [creadoPor], references: [id])
  modificador         Usuario?              @relation("InstrumentoModificador", fields: [modificadoPor], references: [id])
  registros           RegistroFichaCompletada[]
  versiones           InstrumentoVersion[]

  @@index([estado])
  @@index([tipo])
  @@map("instrumentos")
}

model InstrumentoVersion {
  id            Int       @id @default(autoincrement()) @map("instrumento_version_id")
  instrumentoId Int       @map("instrumento_id")
  version       Int       @map("version_numero")
  definition    Json      @map("definicion_jsonb")
  activo        Boolean   @default(false) @map("activo")
  createdAt     DateTime  @default(now()) @map("fecha_creacion")
  createdBy     Int       @map("creado_por")

  instrumento   Instrumento @relation(fields: [instrumentoId], references: [id], onDelete: Cascade)
  creador       Usuario     @relation("InstrumentoVersionCreador", fields: [createdBy], references: [id])
  fichas        RegistroFichaCompletada[]

  @@unique([instrumentoId, version])
  @@index([activo])
  @@index([instrumentoId])
  @@map("instrumentos_versiones")
}

model RegistroFichaCompletada {
  id                      Int                      @id @default(autoincrement()) @map("registro_id")
  clienteId               Int                      @map("cliente_id")
  instrumentoId           Int                      @map("instrumento_id")
  instrumentoVersionId    Int?                     @map("instrumento_version_id")
  estado                  EstadoRegistroFicha      @default(PENDIENTE)
  fechaCompletado         DateTime?                @map("fecha_completado")
  versionRegistro         String                   @map("version_registro") @db.VarChar(20)
  responsable             Int
  respuestas              Json?                    @map("respuestas_jsonb")
  puntajeTotal            Float?                   @map("puntaje_total")
  subtotales              Json?                    @map("subtotales_jsonb")
  clasificacion           String?                  @map("clasificacion") @db.VarChar(100)
  notasObservaciones      String?                  @map("notas_observaciones") @db.Text
  fechaVencimiento        DateTime?                @map("fecha_vencimiento") @db.Date
  alertaVencimiento       String?                  @map("alerta_vencimiento") @db.VarChar(50)
  fechaCreacionRegistro   DateTime                 @default(now()) @map("fecha_creacion_registro")

  // Relations
  cliente                 Cliente                  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  instrumento             Instrumento              @relation(fields: [instrumentoId], references: [id], onDelete: Restrict)
  instrumentoVersion      InstrumentoVersion?      @relation(fields: [instrumentoVersionId], references: [id], onDelete: Restrict)
  usuarioResponsable      Usuario                  @relation("RegistroResponsable", fields: [responsable], references: [id])
  notas                   NotaCliente[]

  @@index([clienteId])
  @@index([instrumentoId])
  @@index([estado])
  @@index([fechaVencimiento])
  @@index([instrumentoVersionId])
  @@map("registros_fichas_completadas")
}

model NotaCliente {
  id              Int              @id @default(autoincrement()) @map("nota_id")
  clienteId       Int              @map("cliente_id")
  registroFichaId Int?             @map("registro_ficha_id")
  tipoNota        TipoNota         @map("tipo_nota")
  fecha           DateTime         @default(now())
  // jul-9 B1: required date the incident occurred (backfilled from `fecha::date` for existing rows)
  fechaIncidente  DateTime         @map("fecha_incidente") @db.Date
  autor           Int
  contenido       String           @db.Text
  prioridad       PrioridadNota    @default(MEDIA)
  visiblePara     VisibilidadNota  @map("visible_para") @default(TODOS)

  // Relations
  cliente         Cliente          @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  registroFicha   RegistroFichaCompletada? @relation(fields: [registroFichaId], references: [id], onDelete: SetNull)
  usuario         Usuario          @relation(fields: [autor], references: [id])

  @@index([clienteId])
  @@index([registroFichaId])
  @@index([fecha])
  @@index([fechaIncidente])
  @@map("notas_clientes")
}

// ========================================
// FINANCE MODULE
// ========================================

model CentroCostos {
  id          Int                @id @default(autoincrement()) @map("centro_id")
  nombre      String             @db.VarChar(200)
  tipo        TipoCentroCostos
  descripcion String?            @db.Text

  // Relations
  productos   ProductoServicio[]
  egresos     Egreso[]

  @@map("centros_costos")
}

model ProductoServicio {
  id                  Int          @id @default(autoincrement()) @map("producto_id")
  centroCostosId      Int          @map("centro_costos_id")
  codigoInterno       String       @map("codigo_interno") @db.VarChar(50)
  nombre              String       @db.VarChar(200)
  precioTotal         Decimal      @map("precio_total") @db.Decimal(15, 2)
  nombreImpuesto      String?      @map("nombre_impuesto") @db.VarChar(100)
  porcentajeImpuesto  Decimal?     @map("porcentaje_impuesto") @db.Decimal(5, 2)
  precioBase          Decimal      @map("precio_base") @db.Decimal(15, 2)
  costoUnitario       Decimal      @map("costo_unitario") @db.Decimal(15, 2)
  cantidadInicial     Int          @map("cantidad_inicial")
  unidadMedida        String       @map("unidad_medida") @db.VarChar(50)
  descripcion         String?      @db.Text
  referencia          String?      @db.VarChar(100)
  cuentaIngresos      String?      @map("cuenta_ingresos") @db.VarChar(50)
  cuentaInventario    String?      @map("cuenta_inventario") @db.VarChar(50)
  cuentaCostoVenta    String?      @map("cuenta_costo_venta") @db.VarChar(50)
  ventaNegativo       Boolean      @map("venta_negativo") @default(false)

  // Relations
  centroCostos CentroCostos @relation(fields: [centroCostosId], references: [id], onDelete: Cascade)
  prefacturas  Prefactura[]

  @@index([centroCostosId])
  @@index([codigoInterno])
  @@map("productos_servicios")
}

model Egreso {
  id                 Int          @id @default(autoincrement()) @map("egreso_id")
  centroCostosId     Int          @map("centro_costos_id")
  codigoInterno      String       @map("codigo_interno") @db.VarChar(50)
  item               String       @db.VarChar(200)
  notas              String?      @db.Text
  proveedorNombre    String       @map("proveedor_nombre") @db.VarChar(200)
  proveedorTipoDoc   String       @map("proveedor_tipo_doc") @db.VarChar(20)
  proveedorNumero    String       @map("proveedor_numero") @db.VarChar(50)
  valor              Decimal      @db.Decimal(15, 2)
  numeroFactura      String       @map("numero_factura") @db.VarChar(100)
  fecha              DateTime     @db.Date

  // Relations
  centroCostos CentroCostos @relation(fields: [centroCostosId], references: [id], onDelete: Cascade)

  @@index([centroCostosId])
  @@index([fecha])
  @@map("egresos")
}

model Prefactura {
  id                  Int              @id @default(autoincrement()) @map("prefactura_id")
  clienteId           Int              @map("cliente_id")
  productoServicioId  Int              @map("producto_servicio_id")
  fechaGeneracion     DateTime         @default(now()) @map("fecha_generacion")
  subtotal            Decimal          @db.Decimal(15, 2)
  impuestos           Decimal          @db.Decimal(15, 2)
  total               Decimal          @db.Decimal(15, 2)
  estado              EstadoPrefactura @default(BORRADOR)

  // Relations
  cliente         Cliente          @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  productoServicio ProductoServicio @relation(fields: [productoServicioId], references: [id], onDelete: Restrict)

  @@index([clienteId])
  @@index([estado])
  @@index([fechaGeneracion])
  @@map("prefacturas")
}

// ========================================
// CERTIFICADOS EMPRESA MODULE
// ========================================

model CertificadoEmpresa {
  id                Int                        @id @default(autoincrement()) @map("cert_empresa_id")
  empresaId         Int                        @map("empresa_id")
  tipoCertificado   TipoCertificadoEmpresa     @map("tipo_certificado")
  nombre            String                     @db.VarChar(200)
  descripcion       String?                    @db.Text
  estado            EstadoCertificadoEmpresa   @default(PENDIENTE)
  fechaEmision      DateTime?                  @map("fecha_emision") @db.Date
  fechaVencimiento  DateTime?                  @map("fecha_vencimiento") @db.Date
  archivoUrl        String?                    @map("archivo_url") @db.VarChar(500)
  periodicidad      PeriodicidadCertificado     @default(UNICA)
  periodo           DateTime?                  @map("periodo") @db.Date
  comprobantePagoUrl String?                    @map("comprobante_pago_url") @db.VarChar(500)
  creadoPor         Int                        @map("creado_por")
  createdAt         DateTime                   @default(now()) @map("created_at")
  updatedAt         DateTime                   @updatedAt @map("updated_at")

  // Relations
  empresa          Empresa                    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  creador          Usuario                    @relation("CertificadoEmpresaCreador", fields: [creadoPor], references: [id])
  updates          CertificadoUpdate[]        @relation("CertificadoUpdates")

  @@index([empresaId])
  @@index([estado])
  @@index([fechaVencimiento])
  @@index([periodicidad])
  @@map("certificados_empresa")
}

model CertificadoUpdate {
  id                Int                       @id @default(autoincrement()) @map("cert_update_id")
  certificadoId     Int                       @map("certificado_id")
  archivoUrl        String?                   @map("archivo_url") @db.VarChar(500)
  // jul-9 A4: payment receipt URL alongside existing archivoUrl
  comprobantePagoUrl String?                  @map("comprobante_pago_url") @db.VarChar(500)
  notas             String?                   @db.Text
  fechaEmision      DateTime?                 @map("fecha_emision") @db.Date
  fechaVencimiento  DateTime?                 @map("fecha_vencimiento") @db.Date
  creadoPor         Int                       @map("creado_por")
  createdAt         DateTime                  @default(now()) @map("created_at")

  // Relations
  certificado       CertificadoEmpresa        @relation("CertificadoUpdates", fields: [certificadoId], references: [id], onDelete: Cascade)
  creador           Usuario                   @relation("CertificadoUpdateCreador", fields: [creadoPor], references: [id])

  @@index([certificadoId])
  @@index([createdAt])
  @@map("certificados_empresa_updates")
}

// ========================================
// EMPRESA MODULE
// ========================================

model Empresa {
  id        Int      @id @default(autoincrement())
  nombre    String   @db.VarChar(200)
  nit       String   @unique @db.VarChar(50)
  direccion String?  @db.VarChar(255)
  telefono  String?  @db.VarChar(20)
  email     String?  @db.VarChar(255)
  activa    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  certificados CertificadoEmpresa[]
  // jul-9 D7: per-empresa cargo catalog
  cargosEmpresa  CargoEmpresa[]

  @@map("empresas")
}

