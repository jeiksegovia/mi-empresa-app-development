{
  "name": "foia-api-layer",
  "version": "0.0.0-pre.15",
  "private": true,
  "scripts": {
    "db:up": "docker-compose up -d",
    "db:stop": "docker-compose stop",
    "db:down": "docker-compose down --volumes",
    "db:generate": "prisma generate",
    "db:migrate": "yarn db:validate-env && prisma migrate dev",
    "db:seed": "yarn db:validate-env && tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:validate-env": "node -e \"require('dotenv').config(); if (!process.env.DATABASE_URL) { console.error('DATABASE_URL is not set'); process.exit(1); } if (process.env.DATABASE_URL.includes('localhost') || process.env.LIVE_DB === 'live' ) { console.log('DATABASE_URL is set to a '+(process.env.LIVE_DB||'local')+' database'); } else { console.error('DATABASE_URL must be local database'); process.exit(1); }\"",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "serve": "pm2 start dist/src/server.js --name foia-api -i max --time",
    "stop": "pm2 delete foia-api || true",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.876.0",
    "@aws-sdk/credential-providers": "^3.876.0",
    "@aws-sdk/lib-storage": "^3.896.0",
    "@aws-sdk/s3-request-presigner": "^3.876.0",
    "@prisma/adapter-pg": "^6.16.1",
    "@prisma/client": "^6.13.0",
    "@types/cookie-parser": "^1.4.9",
    "axios": "^1.11.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "esbuild": "^0.25.9",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pdf-lib": "^1.17.1",
    "prisma": "^6.16.1",
    "sharp": "^0.33.4",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@faker-js/faker": "^9.9.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/helmet": "^4.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^9.0.7",
    "eslint": "^9",
    "jest": "^30.0.5",
    "pm2": "^6.0.10",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "tsx": "^4.19.2",
    "typescript": "^5"
  },
  "volta": {
    "node": "22.18.0",
    "yarn": "1.22.19"
  }
}
