        { "id": "ot_mes",     "label": "¿En qué mes?",                       "type": "single-select-scored", "required": true, "options": [{ "value": "correcto", "label": "Correcto", "score": 1 }, { "value": "incorrecto", "label": "Incorrecto", "score": 0 }] },
        { "id": "ot_anio",    "label": "¿En qué año?",                       "type": "single-select-scored", "required": true, "options": [{ "value": "correcto", "label": "Correcto", "score": 1 }, { "value": "incorrecto", "label": "Incorrecto", "score": 0 }] },
