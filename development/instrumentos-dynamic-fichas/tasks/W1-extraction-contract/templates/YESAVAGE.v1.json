        { "id": "y_10", "label": "¿Siente Ud. que tiene más problemas con su memoria que otras personas de su edad?", "type": "single-select-scored", "required": true, "options": [{ "value": "si", "label": "SI", "score": 1 }, { "value": "no", "label": "No", "score": 0 }] },
