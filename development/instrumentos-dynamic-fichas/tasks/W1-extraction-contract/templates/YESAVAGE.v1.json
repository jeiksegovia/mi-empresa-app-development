        { "id": "y_12", "label": "¿Se siente inútil o despreciable como está Ud. actualmente?",          "type": "single-select-scored", "required": true, "options": [{ "value": "si", "label": "SI", "score": 1 }, { "value": "no", "label": "No", "score": 0 }] },
        { "id": "y_13", "label": "¿Se siente lleno de energía?",                                         "type": "single-select-scored", "required": true, "options": [{ "value": "si", "label": "Sí", "score": 0 }, { "value": "no", "label": "NO", "score": 1 }] },
        { "id": "y_14", "label": "¿Se encuentra sin esperanza ante su situación actual?",                 "type": "single-select-scored", "required": true, "options": [{ "value": "si", "label": "SI", "score": 1 }, { "value": "no", "label": "No", "score": 0 }] },
        { "id": "y_15", "label": "¿Cree Ud. que las otras personas están en general mejor que Usted?",   "type": "single-select-scored", "required": true, "options": [{ "value": "si", "label": "SI", "score": 1 }, { "value": "no", "label": "No", "score": 0 }] }
