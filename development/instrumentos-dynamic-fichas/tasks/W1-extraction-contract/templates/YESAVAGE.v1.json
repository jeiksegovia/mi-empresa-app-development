        { "id": "y_05", "label": "¿Está Ud. de buen ánimo la mayoría del tiempo?",                       "type": "single-select-scored", "required": true, "options": [{ "value": "si", "label": "Sí", "score": 0 }, { "value": "no", "label": "NO", "score": 1 }] },
        { "id": "y_06", "label": "¿Está preocupado o teme que algo malo le va a pasar?",                  "type": "single-select-scored", "required": true, "options": [{ "value": "si", "label": "SI", "score": 1 }, { "value": "no", "label": "No", "score": 0 }] },
        { "id": "y_07", "label": "¿Se siente feliz la mayor parte del tiempo?",                          "type": "single-select-scored", "required": true, "options": [{ "value": "si", "label": "Sí", "score": 0 }, { "value": "no", "label": "NO", "score": 1 }] },
